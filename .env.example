# Copy this file to .env and fill in real values. Never commit .env itself.

DATABASE_URL=postgresql+asyncpg://longdimming:longdimming@localhost:5432/longdimming
REDIS_URL=redis://localhost:6379/0

JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Hours a new Hold is protected from attack before PvP opens up
KINDLING_SHIELD_HOURS=48

# Percent-point margin used by compute_bloodline_status to decide "no viable path back" for Fade
FADE_RECOVERY_MARGIN=0.05
